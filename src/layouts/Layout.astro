---
interface Props {
	title?: string;
	active?: 'frameworks' | 'composition' | 'nesting' | 'nanostores';
}
const { title = 'Astro framework variance', active = 'frameworks' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<nav class="tabs" aria-label="Demos">
			<a href="/" aria-current={active === 'frameworks' ? 'page' : undefined}>Frameworks</a>
			<a href="/composition/" aria-current={active === 'composition' ? 'page' : undefined}>
				Composition &amp; shared state
			</a>
			<a href="/nesting/" aria-current={active === 'nesting' ? 'page' : undefined}>
				Cross-framework nesting
			</a>
			<a href="/nanostores/" aria-current={active === 'nanostores' ? 'page' : undefined}>
				Nanostores
			</a>
		</nav>
		<slot />
		<script>
			import 'htmx.org';

			// htmx drops 4xx/5xx and network failures silently; surface them in the target.
			const showError = (e: Event) => {
				const { target, elt, xhr } = (e as CustomEvent).detail;
				const hint = (elt as HTMLElement | undefined)?.dataset.errorHint ?? '';
				if (target) {
					const status = xhr?.status ? `HTTP ${xhr.status}` : 'network error';
					target.innerHTML = `<p class="fact">Request failed (${status}). ${hint}</p>`;
				}
			};
			document.body.addEventListener('htmx:responseError', showError);
			document.body.addEventListener('htmx:sendError', showError);
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #f6f5fb;
		--card: #ffffff;
		--ink: #16151d;
		--muted: #5d5b6b;
		--line: #e3e1ee;
		--accent: #5b4bff;
		color-scheme: light;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #121118;
			--card: #1c1a26;
			--ink: #f1f0f7;
			--muted: #a19fb3;
			--line: #2e2b3d;
			--accent: #8f84ff;
			color-scheme: dark;
		}
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family: Inter, Roboto, 'Helvetica Neue', Arial, sans-serif;
		line-height: 1.5;
	}
	.counter {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.counter pre {
		margin: 0;
		min-width: 2ch;
		text-align: center;
		font-size: 1.4rem;
	}
	button {
		font: inherit;
		color: inherit;
		background: transparent;
		border: 1px solid var(--line);
		border-radius: 8px;
		padding: 4px 12px;
		cursor: pointer;
	}
	button:hover {
		border-color: var(--accent);
	}
	.tabs {
		display: flex;
		gap: 4px;
		max-width: 1100px;
		margin: 0 auto;
		padding: 16px 16px 0;
		border-bottom: 1px solid var(--line);
		flex-wrap: wrap;
	}
	.tabs a {
		padding: 8px 14px;
		border-radius: 8px 8px 0 0;
		color: var(--muted);
		text-decoration: none;
		border: 1px solid transparent;
		margin-bottom: -1px;
	}
	.tabs a[aria-current='page'] {
		color: var(--ink);
		background: var(--bg);
		border-color: var(--line);
		border-bottom-color: var(--bg);
		font-weight: 600;
	}
	/* Parent > Child > Grandchild boxes used by the composition demos */
	.node {
		border: 1px dashed var(--line);
		border-radius: 8px;
		padding: 6px 8px;
		font-size: 0.78rem;
		width: 100%;
	}
	.node .tag {
		font-weight: 600;
		color: var(--accent);
		margin-right: 6px;
	}
	.node .node {
		margin-top: 6px;
	}
	.node button {
		padding: 1px 8px;
		margin-left: 6px;
	}
	/* Wrapper frames used by the cross-framework nesting demo */
	.frame {
		border: 1px solid var(--accent);
		border-radius: 10px;
		padding: 8px 10px;
		width: 100%;
		background: color-mix(in srgb, var(--accent) 4%, transparent);
	}
	.frame-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 12px;
		font-size: 0.8rem;
		color: var(--muted);
	}
	.frame-head b {
		color: var(--accent);
	}
	.frame-head output {
		color: var(--ink);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.frame-head button {
		padding: 1px 8px;
	}
	.frame-body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-top: 8px;
	}
	.fact {
		margin: 0;
		font-size: 0.9rem;
		color: var(--muted);
	}
</style>
